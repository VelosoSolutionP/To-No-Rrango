# Copie para .env e preencha. O arquivo .env nunca vai para o Git.
EVOLUTION_API_KEY=
# Mínimo de 32 caracteres
TNR_JWT_KEY=
# 32 bytes em base64: openssl rand -base64 32
TNR_ENCRYPTION_KEY=
TNR_ADMIN_KEY=
TNR_OWNER_PASSWORD=
# Emissão fiscal: Monitor liga o ACBrMonitor. Ambiente 2 = homologação, 1 = produção.
ACBR_MODE=Off
ACBR_HOST=host.docker.internal
ACBR_PORT=3434
ACBR_ENVIRONMENT=2
# Consulta de produtos por código de barras (API GTIN, 2 consultas por minuto)
TNR_GTIN_USUARIO=
TNR_GTIN_SENHA=
